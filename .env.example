NODE_ENV=development
PORT=3030

# Browser origins allowed for CORS (comma-separated). Leave unset to mirror the request Origin (handy for local dev).
# CORS_ORIGIN=http://localhost:3000

# PostgreSQL
DATABASE_URL=
# JWT (generate strong secrets for production)
JWT_ACCESS_SECRET=change-me-access-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-min-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
# Optional: separate secret for password-reset links (defaults to JWT_REFRESH_SECRET if unset)
# JWT_PASSWORD_RESET_SECRET=
# PASSWORD_RESET_TOKEN_EXPIRES=1h

# Base URL of your web app (emails link to {FRONTEND_URL}/reset-password?token=..., /verify-email?token=...)
# FRONTEND_URL=http://localhost:3000

# Email verification (signup); JWT in link — optional dedicated secret (defaults like password reset)
# JWT_EMAIL_VERIFICATION_SECRET=
# EMAIL_VERIFICATION_TOKEN_EXPIRES=48h

# Redis (BullMQ + optional URL cache)
REDIS_URL=

# Default markup on imported products (%)
DEFAULT_MARKUP_PERCENT=10

# Optional: proxy for Playwright retail scrapes (residential/datacenter provider URL).
# Amazon: repo amazon.html was saved from a Scrape.do fetch — raw Playwright often differs; use a US proxy.
# Bright Data example: SCRAPE_PROXY=http://user:pass@brd.superproxy.io:33335
# Scrape.do (see docs for exact host/port; token often as basic-auth user): 
# SCRAPE_PROXY=http://YOUR_TOKEN@api.scrape.do:80
SCRAPE_PROXY=
# Optional scrape.do geo targeting (ISO country code), e.g. us, gb, de.
# Leave empty to auto-infer from URL country TLD where possible.
# SCRAPE_PROXY_GEO_CODE=us

# Storefront locale (matches Scrape.do-style US HTML; avoids e.g. ko-KR when your server is in Asia)
# SCRAPE_LOCALE=en-US
# SCRAPE_ACCEPT_LANGUAGE=en-US,en;q=0.9
# SCRAPE_TIMEZONE_ID=America/Los_Angeles

# OpenRouter LLM (Stepfun flash free by default) — https://openrouter.ai
# OPEN_ROUTER_ENABLED=true
# OPEN_ROUTER_API_KEY=
# OPEN_ROUTER_MODEL=stepfun/step-3.5-flash:free
# OPENROUTER_HTTP_REFERER=http://localhost:3030
# Optional default system prompt for all gateway calls
# LLM_SYSTEM_PROMPT=
# After adapter scrape, ask the LLM to normalize pricing / variant rows (requires OPEN_ROUTER_ENABLED + key)
# SCRAPE_OPENROUTER_REFINE=true
# Legacy aliases still work: OPENROUTER_API_KEY, OPENROUTER_MODEL

# Paystack (https://paystack.com)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Optional; defaults to PAYSTACK_SECRET_KEY for HMAC if unset
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_CALLBACK_URL=https://your-app.example/payment/callback
PAYSTACK_CURRENCY=NGN

# Stripe (https://stripe.com) — optional second provider
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Success URL must include {CHECKOUT_SESSION_ID} (Stripe replaces it)
STRIPE_CHECKOUT_SUCCESS_URL=https://your-app.example/checkout/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CHECKOUT_CANCEL_URL=https://your-app.example/checkout/cancel

# PayPal Checkout (https://developer.paypal.com) — optional third provider
PAYPAL_CLIENT_ID=
PAYPAL_SECRET_KEY=
# sandbox | live
PAYPAL_MODE=sandbox
PAYPAL_RETURN_URL=https://your-app.example/checkout/paypal/success
PAYPAL_CANCEL_URL=https://your-app.example/checkout/paypal/cancel

# Myaza Crypto Checkout — optional fourth provider
# Uses X-API-Key auth
MYAZA_API_KEY=
# API base URL (adjust if your Myaza account uses another host)
MYAZA_BASE_URL=https://api.myaza.io
MYAZA_RETURN_URL=https://your-app.example/checkout/myaza/success
MYAZA_CANCEL_URL=https://your-app.example/checkout/myaza/cancel
# Optional webhook signature secret for POST /payments/webhooks/myaza
MYAZA_WEBHOOK_SECRET=

# Optional temporary checkout method kill-switches (set true/1 to disable)
PAYMENT_DISABLE_PAYSTACK=
PAYMENT_DISABLE_STRIPE=
PAYMENT_DISABLE_PAYPAL=
PAYMENT_DISABLE_MYAZA=

# Email — Resend (https://resend.com)
RESEND_API_KEY=
# Custom from (requires verified domain at resend.com/domains). Ignored when using sandbox below.
RESEND_FROM="Unified Commerce <orders@yourdomain.com>"
MAIL_FROM=
# Sandbox: no domain verification — uses onboarding@resend.dev. Default in non-production when unset.
# Set RESEND_SANDBOX=false to test a verified domain locally. In production, unset uses RESEND_FROM.
# RESEND_SANDBOX=true
