# Local: development enables TypeORM synchronize. Production / Railway: use production + migrations, not sync.
NODE_ENV=development
PORT=3030

# Browser origins allowed for CORS (comma-separated; must match the browser Origin header, usually http://…). Omit to echo any Origin (dev only — avoid in production).
CORS_ORIGIN=http://localhost:3000
# On Railway with a fixed CORS_ORIGIN for prod, set true to allow any http(s)://localhost:* or 127.0.0.1:* (any port).
# CORS_ALLOW_LOCALHOST=true

# PostgreSQL
DATABASE_URL=
# Force TypeORM synchronize off (recommended on Railway even if NODE_ENV is wrong): DATABASE_SYNCHRONIZE=false
# After first deploy, run: pnpm run migration:run
# JWT (generate strong secrets for production)
JWT_ACCESS_SECRET=change-me-access-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-min-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
# 2FA: short-lived token after correct password (defaults signing to JWT_ACCESS_SECRET if unset)
# JWT_2FA_PREAUTH_SECRET=change-me-2fa-preauth-optional
# JWT_2FA_PREAUTH_EXPIRES=5m
# Name shown in authenticator apps
# TOTP_ISSUER_NAME=Unified Commerce

# Optional: separate secret for password-reset links (defaults to JWT_REFRESH_SECRET if unset)
# JWT_PASSWORD_RESET_SECRET=
# PASSWORD_RESET_TOKEN_EXPIRES=1h

# Base URL of your web app (emails link to {FRONTEND_URL}/reset-password?token=..., /verify-email?token=...)
# FRONTEND_URL=http://localhost:3000

# Email verification (signup); JWT in link — optional dedicated secret (defaults like password reset)
# JWT_EMAIL_VERIFICATION_SECRET=
# EMAIL_VERIFICATION_TOKEN_EXPIRES=48h

# Redis (BullMQ + optional URL cache)
REDIS_URL=

# Default markup on imported products (%)
DEFAULT_MARKUP_PERCENT=10

# Optional: proxy for Playwright retail scrapes (residential/datacenter provider URL).
# Amazon: repo amazon.html was saved from a Scrape.do fetch — raw Playwright often differs; use a US proxy.
# Bright Data example: SCRAPE_PROXY=http://user:pass@brd.superproxy.io:33335
# Scrape.do (see docs for exact host/port; token often as basic-auth user): 
# SCRAPE_PROXY=http://YOUR_TOKEN@api.scrape.do:80
SCRAPE_PROXY=
# Optional scrape.do geo targeting (ISO country code), e.g. us, gb, de.
# Leave empty to auto-infer from URL country TLD where possible.
# SCRAPE_PROXY_GEO_CODE=us

# Storefront locale (matches Scrape.do-style US HTML; avoids e.g. ko-KR when your server is in Asia)
# SCRAPE_LOCALE=en-US
# SCRAPE_ACCEPT_LANGUAGE=en-US,en;q=0.9
# SCRAPE_TIMEZONE_ID=America/Los_Angeles

# Playwright TLS: with SCRAPE_PROXY, untrusted proxy MITM certs are ignored by default.
# Without a proxy, set `true` if you see net::ERR_CERT_AUTHORITY_INVALID; use `false` to opt out when using a proxy.
# SCRAPE_IGNORE_HTTPS_ERRORS=true
# SCRAPE_IGNORE_HTTPS_ERRORS=false

# OpenRouter LLM (Stepfun flash free by default) — https://openrouter.ai
# OPEN_ROUTER_ENABLED=true
# OPEN_ROUTER_API_KEY=
# OPEN_ROUTER_MODEL=stepfun/step-3.5-flash:free
# OPENROUTER_HTTP_REFERER=http://localhost:3030
# Optional default system prompt for all gateway calls
# LLM_SYSTEM_PROMPT=
# After adapter scrape, ask the LLM to normalize pricing / variant rows (requires OPEN_ROUTER_ENABLED + key)
# SCRAPE_OPENROUTER_REFINE=true
# Legacy aliases still work: OPENROUTER_API_KEY, OPENROUTER_MODEL

# Paystack (https://paystack.com)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Optional; defaults to PAYSTACK_SECRET_KEY for HMAC if unset
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_CALLBACK_URL=https://your-app.example/payment/callback
PAYSTACK_CURRENCY=NGN

# Stripe (https://stripe.com) — optional second provider
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Success URL must include {CHECKOUT_SESSION_ID} (Stripe replaces it)
STRIPE_CHECKOUT_SUCCESS_URL=https://your-app.example/checkout/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CHECKOUT_CANCEL_URL=https://your-app.example/checkout/cancel

# PayPal Checkout (https://developer.paypal.com) — optional third provider
PAYPAL_CLIENT_ID=
# Use PAYPAL_SECRET_KEY and/or PayPal’s usual name:
PAYPAL_SECRET_KEY=
# PAYPAL_CLIENT_SECRET=
# sandbox (default) | live | production — must match the Client ID/Secret (sandbox app vs live app)
PAYPAL_MODE=sandbox
PAYPAL_RETURN_URL=https://your-app.example/checkout/paypal/success
PAYPAL_CANCEL_URL=https://your-app.example/checkout/paypal/cancel

# Myaza Crypto Checkout — optional fourth provider
# Uses X-API-Key auth
MYAZA_API_KEY=
# x-api-key (default) = header X-API-Key. bearer = Authorization: Bearer <MYAZA_API_KEY> (use if API returns "No auth token" / 401)
# MYAZA_AUTH_MODE=bearer
# API base: host only (https://api.myaza.io) OR include /api/v1 (e.g. https://myaza-api.onrender.com/api/v1) — default session path is deduped
MYAZA_BASE_URL=https://api.myaza.io
# Override if your API uses a different route (default /api/v1/pos/sessions)
# MYAZA_SESSIONS_PATH=/api/v1/pos/sessions
MYAZA_RETURN_URL=https://your-app.example/checkout/myaza/success
MYAZA_CANCEL_URL=https://your-app.example/checkout/myaza/cancel
# Optional webhook signature secret for POST /payments/webhooks/myaza
MYAZA_WEBHOOK_SECRET=

# Optional temporary checkout method kill-switches (set true/1 to disable)
PAYMENT_DISABLE_PAYSTACK=
PAYMENT_DISABLE_STRIPE=
PAYMENT_DISABLE_PAYPAL=
PAYMENT_DISABLE_MYAZA=

# Passkeys / WebAuthn (https://simplewebauthn.dev)
# PASSKEY_RP_ID must be the bare hostname of your frontend — no protocol, no path, no port.
# Local dev: localhost   |   Production: yourdomain.com or sub.yourdomain.com
# WARNING: do NOT use a mobile bundle-ID format (e.g. com.example.app) — WebAuthn requires a real domain.
PASSKEY_RP_ID=localhost
PASSKEY_RP_NAME=Unified Commerce
# Comma-separated allowed browser origins (must match window.location.origin exactly, including port).
# Falls back to FRONTEND_URL / PUBLIC_APP_URL when unset.
PASSKEY_ORIGIN=http://localhost:3000

# Email — MailerSend (https://mailersend.com)
MAILERSEND_API_KEY=
# Requires a verified domain at mailersend.com/domains (or your trial-*.mlsender.net sender).
MAILERSEND_FROM="Unified Commerce <orders@yourdomain.com>"
MAIL_FROM=

# WhatsApp — Meta Cloud API (https://developers.facebook.com/docs/whatsapp/cloud-api)
# Unset = sendWhatsApp() logs a warning and no-ops (same behavior as the SMS stub).
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
# META_WHATSAPP_API_VERSION=v21.0

# Set to true once WhatsApp is configured to require phone verification before checkout
# (POST /orders, POST /wanna-buy/:id/pay). Defaults to off so checkout isn't blocked
# before a provider is actually wired up.
# PHONE_VERIFICATION_REQUIRED=true

# Object storage — S3-compatible bucket for admin product image uploads (POST /admin/uploads).
# On Railway: `railway bucket create uploads` then `railway bucket credentials --bucket uploads --json`.
# Buckets are private (no public bucket URL) — images are served back out via GET /uploads/:key.
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Public base URL of this API, used to build the GET /uploads/:key image URL.
# Falls back to RAILWAY_PUBLIC_DOMAIN (auto-set by Railway) when unset.
# API_PUBLIC_URL=http://localhost:3000
